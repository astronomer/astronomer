#!/usr/bin/env bash
# This is used in local dev, and in CI. Usage: reset-local-dev --topology=<unified|control|data>
# [extra flags forwarded to helm-install.py, e.g. --helm-values=... --namespace-label=key=value]

GIT_ROOT_DIR="$(git rev-parse --show-toplevel)"
BIN_DIR="${GIT_ROOT_DIR}/bin"

TOPOLOGY=""
CLUSTER_PROVIDER="kind"
PRE_HELM_SCRIPTS=()
HELM_ARGS=()
for arg in "$@"; do
  case "$arg" in
    # Siphoned off (not forwarded to helm-install.py): scenario setup that runs after
    # the cluster exists but before `helm install`. See run-scenario.py / scenarios/README.md.
    --pre-helm-script=*) PRE_HELM_SCRIPTS+=("${arg#--pre-helm-script=}") ;;
    # Picks bin/setup-<provider>.py below; both write the same kubeconfig and secrets.
    --cluster-provider=*) CLUSTER_PROVIDER="${arg#--cluster-provider=}" ;;
    --topology=*) TOPOLOGY="${arg#--topology=}" ; HELM_ARGS+=("$arg") ;;
    *) HELM_ARGS+=("$arg") ;;
  esac
done
if [[ -z "$TOPOLOGY" ]]; then
  echo "ABORT: --topology=<unified|control|data> is required" >&2
  exit 1
fi
# Named explicitly, so the flag can only select a setup script this repo ships.
case "$CLUSTER_PROVIDER" in
  kind|openshift) ;;
  *) echo "ABORT: --cluster-provider must be kind or openshift, got '${CLUSTER_PROVIDER}'" >&2 ; exit 1 ;;
esac

# Use the venv if it exists
[[ -f .venv/bin/activate ]] || { echo "ABORT: .venv does not exist!" ; exit 1 ; }

# shellcheck disable=SC1091
. .venv/bin/activate

set -ex

# Download helper tools to ~/.local/share/astronomer-software/bin
"${BIN_DIR}/install-ci-tools.py"

# install-ci-tools.py only puts this directory on PATH within its own process, which
# doesn't help anything shelled out to below (e.g. setup-kind.py -> show_docker_images.py's
# bare `helm template` call). Export it here so it's on PATH for the rest of this script.
export PATH="${HOME}/.local/share/astronomer-software/bin:${PATH}"

# Generate certificates in ~/.local/share/astronomer-software/certs. (No separate
# "private CA" step: the cluster setup script resolves mkcert's own root CA directly, via the same
# mkcert -CAROOT mechanism the k3d CP/DP topology's setup script uses, and generate-tls
# above already ran `mkcert -install` so that CA root exists.)
"${BIN_DIR}/certs.py" cleanup
"${BIN_DIR}/certs.py" generate-tls

# Create the cluster and configure it for testing
"${BIN_DIR}/setup-${CLUSTER_PROVIDER}.py" "--topology=${TOPOLOGY}"

# Run scenario pre-helm setup steps (see tests/functional/scenarios/README.md). These run
# after the cluster exists but before `helm install`, so a scenario can create Secrets or
# other namespaced objects that the chart's install-time values reference (e.g. a private-CA
# Secret named in global.privateCaCerts). Each script gets KUBECONFIG pointed at the fresh
# cluster, the activated venv, and the helper-tools PATH exported above.
export KUBECONFIG="${HOME}/.local/share/astronomer-software/kubeconfig/${TOPOLOGY}"
for script in "${PRE_HELM_SCRIPTS[@]}"; do
  echo "Running pre-helm script: ${script}"
  # Each entry may carry arguments (a shell-quoted "path --flag value ..." from run-scenario.py),
  # so run it through the shell rather than as a bare argv[0].
  bash -c "${script}"
done

# Install helm chart
"${BIN_DIR}/helm-install.py" "${HELM_ARGS[@]}"
