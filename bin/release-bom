#!/usr/bin/env bash
# shellcheck disable=SC1090,SC1091
set -euo pipefail

latest_github_release() {
  local repo="${1}"
  curl -fsSL -H "Authorization: token ${GITHUB_TOKEN}" \
    "https://api.github.com/repos/${repo}/releases/latest" \
    | python3 -c "import sys, json; print(json.load(sys.stdin)['tag_name'])"
}

help() {
  echo "Description:"
  echo "    Generate and publish a BOM JSON file for the given version and update the index.html"
  echo "    in the public release repository."
  echo
  echo "Usage:"
  echo "    ${0##*/} [-x] [-n] <version>"
  echo
  echo "Options:"
  echo "    -x  trace execution"
  echo "    -n  dry run: generate the BOM, but do not upload it or update the indexes"
}

dry_run=""
while getopts ':hxn' option ; do
  case "${option}" in
    h) help ; exit ;;
    x) set -x ;;
    n) dry_run="1" ;;
    *) help ; exit 1 ;;
  esac
done
shift $((OPTIND - 1))

if [[ "${#@}" -eq 0 ]] ; then
  echo "ERROR: missing version argument"
  echo
  help
  exit 1
fi

version="${1#v}"
shift
repo_url="https://updates.astronomer.io/astronomer-software/releases"
bucket_path="gs://updates.astronomer.io/astronomer-software/releases"
json_file_name="astronomer-${version}.json"
max_age="300"

# Install bom-generator (latest release)
# The CI image ships Python 3.12, but bom-generator requires >=3.13
bom_tag=$(latest_github_release "astronomer/astronomer-bom-generator")
uv tool install --python 3.13 "git+https://${GITHUB_TOKEN}@github.com/astronomer/astronomer-bom-generator.git@${bom_tag}"

# Generate bom file and indexes
"$HOME/.local/bin/bom-generator" --version "${version}"

# Verify that we generated the desired bom file
if [ ! -f "${json_file_name}" ]; then
  echo "ERROR: Failed to generate ${json_file_name}"
  exit 1
fi

if [[ -n "${dry_run}" ]] ; then
  echo "Dry run: generated ${json_file_name}, skipping upload to ${bucket_path}"
  exit 0
fi

gcloud auth activate-service-account --key-file=<(echo "${GCP_TOKEN}")

echo "Uploading ${json_file_name} to ${bucket_path}..."
gsutil -h "Cache-Control: public, max-age=${max_age}" cp "${json_file_name}" "${bucket_path}"

echo "Updating index files"
gsutil -h "Cache-Control: public, max-age=${max_age}" -m cp index.html index.json "${bucket_path}/"

echo "Successfully published new data to:
  ${repo_url}/index.html
  ${repo_url}/index.json"
